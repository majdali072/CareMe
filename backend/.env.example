# Copy to backend/.env and fill in. .env is gitignored — NEVER commit it.
# Leave ADMIN*_PASSWORD empty to be prompted securely via getpass at runtime.

ADMIN1_NAME=
ADMIN1_EMAIL=
ADMIN1_PASSWORD=

ADMIN2_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=

# --- Field-level encryption -------------------------------------------------
# LOCAL/DEV: a plaintext Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# PRODUCTION (AWS KMS envelope encryption — most secure):
#   1. Create a KMS key and set KMS_KEY_ID (id, ARN, or alias/<name>) + AWS_REGION.
#   2. Wrap the key:  python manage.py wrap_encryption_key
#   3. Put the printed value in FIELD_ENCRYPTION_KEY_CIPHERTEXT and remove the
#      plaintext FIELD_ENCRYPTION_KEY from the server.
# Both key vars accept a comma-separated list (newest first) for rotation.
AWS_REGION=us-east-1
KMS_KEY_ID=
FIELD_ENCRYPTION_KEY_CIPHERTEXT=
